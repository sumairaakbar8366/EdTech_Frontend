{
  "name": "schoolerp",
  "version": "0.1.0",
  "private": true,
  "description": "SchoolERP web frontend (school dashboards and platform console)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @schoolerp/shared && npm run build -w @schoolerp/web",
    "build:shared": "npm run build -w @schoolerp/shared",
    "dev": "npm run build:shared && npm run dev -w @schoolerp/web",
    "dev:web": "npm run dev -w @schoolerp/web",
    "preview": "npm run preview -w @schoolerp/web",
    "test": "npm run test -w @schoolerp/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
